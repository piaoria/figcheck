{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:figcheck:shadows:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "layers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "css": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "mapping": {
      "enum": [
        "getCSSAsync",
        "computed"
      ]
    },
    "layers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "inset",
          "x",
          "y",
          "blur",
          "spread",
          "color"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "effectIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "inset": {
            "type": "boolean"
          },
          "x": {
            "type": "number",
            "minimum": -10000000,
            "maximum": 10000000
          },
          "y": {
            "type": "number",
            "minimum": -10000000,
            "maximum": 10000000
          },
          "blur": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "spread": {
            "type": "number",
            "minimum": -10000000,
            "maximum": 10000000
          },
          "color": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ]
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "type",
          "visible"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "visible": {
            "type": "boolean"
          },
          "x": {
            "type": "number",
            "minimum": -10000000,
            "maximum": 10000000
          },
          "y": {
            "type": "number",
            "minimum": -10000000,
            "maximum": 10000000
          },
          "radius": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "spread": {
            "type": "number",
            "minimum": -10000000,
            "maximum": 10000000
          },
          "color": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 255
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ]
          },
          "blendMode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "showShadowBehindNode": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unknown",
              "unsupported"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}